<#
.SYNOPSIS
    Distributes APK to Firebase App Distribution

.DESCRIPTION
    Uploads an APK file to Firebase App Distribution for testing.
    Auto-detects APK path and Firebase app ID if not provided.
    Supports release notes, tester groups, dry-run mode, and debug output.

.PARAMETER ApkPath
    Path to APK file. If empty, auto-detects from build/app/outputs/flutter-apk/app-release.apk

.PARAMETER AppId
    Firebase app ID. If empty, extracts from firebase.json

.PARAMETER ReleaseNotes
    Release notes text or file path (prefix with @ for file: @CHANGELOG.md)

.PARAMETER Groups
    Comma-separated tester group aliases (default: internal-testers)

.PARAMETER DryRun
    Preview actions without executing upload

.PARAMETER Debug
    Enable verbose Firebase CLI output

.EXAMPLE
    .\distribute-apk.ps1
    Basic usage with auto-detection

.EXAMPLE
    .\distribute-apk.ps1 -ReleaseNotes "Bug fixes" -Groups "qa-testers"
    With custom release notes and tester group

.EXAMPLE
    .\distribute-apk.ps1 -DryRun
    Preview what would be uploaded

.NOTES
    Requires Firebase CLI installed and authenticated
    See: docs/firebase-distribution-guide.md
#>

param(
    [Parameter(Mandatory=$false)]
    [string]$ApkPath = "",
    
    [Parameter(Mandatory=$false)]
    [string]$AppId = "",
    
    [Parameter(Mandatory=$false)]
    [string]$ReleaseNotes = "",
    
    [Parameter(Mandatory=$false)]
    [string]$Groups = "internal-testers",
    
    [Parameter(Mandatory=$false)]
    [switch]$DryRun,
    
    [Parameter(Mandatory=$false)]
    [switch]$Debug
)

# Set error handling
$ErrorActionPreference = "Stop"
$script:StartTime = Get-Date

#region Helper Functions

function Write-Log {
    param(
        [string]$Message,
        [string]$Level = "INFO"
    )
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logMessage = "[$timestamp] [$Level] $Message"
    
    switch ($Level) {
        "ERROR" { Write-Host $logMessage -ForegroundColor Red }
        "WARNING" { Write-Host $logMessage -ForegroundColor Yellow }
        "SUCCESS" { Write-Host $logMessage -ForegroundColor Green }
        default { Write-Host $logMessage }
    }
}

function Write-Step {
    param(
        [int]$Step,
        [int]$Total,
        [string]$Message
    )
    Write-Host "`n[Step $Step/$Total] $Message..." -ForegroundColor Cyan
}

function Test-FirebaseCli {
    Write-Log "Checking Firebase CLI installation..."
    
    try {
        $version = firebase --version 2>&1
        if ($LASTEXITCODE -ne 0) {
            throw "Firebase CLI not responding"
        }
        Write-Log "✓ Firebase CLI installed ($version)" "SUCCESS"
        return $true
    }
    catch {
        Write-Log "ERROR: Firebase CLI not found" "ERROR"
        Write-Log "Install: npm install -g firebase-tools" "ERROR"
        Write-Log "Documentation: https://firebase.google.com/docs/cli" "ERROR"
        return $false
    }
}

function Test-FirebaseAuth {
    Write-Log "Checking Firebase authentication..."
    
    # Check for CI token first
    if ($env:FIREBASE_TOKEN) {
        Write-Log "✓ Using FIREBASE_TOKEN from environment (CI mode)" "SUCCESS"
        return $true
    }
    
    # Check local authentication
    try {
        $authCheck = firebase login:list 2>&1 | Out-String
        if ($authCheck -match "No authorized accounts" -or $LASTEXITCODE -ne 0) {
            throw "Not authenticated"
        }
        Write-Log "✓ Authenticated with Firebase" "SUCCESS"
        return $true
    }
    catch {
        Write-Log "Firebase authentication required" "ERROR"
        Write-Log "Run: firebase login" "ERROR"
        Write-Log "OR set FIREBASE_TOKEN environment variable for CI" "ERROR"
        return $false
    }
}

function Get-ApkPath {
    param([string]$CustomPath)
    
    Write-Log "Resolving APK path..."
    
    # Use custom path if provided
    if ($CustomPath) {
        if (Test-Path $CustomPath) {
            $apk = Get-Item $CustomPath
            Write-Log "✓ Using custom APK: $CustomPath ($(Format-FileSize $apk.Length))" "SUCCESS"
            return $CustomPath
        }
        else {
            Write-Log "ERROR: Custom APK not found: $CustomPath" "ERROR"
            exit 3
        }
    }
    
    # Auto-detect from standard Flutter build output
    $defaultPath = "build\app\outputs\flutter-apk\app-release.apk"
    if (Test-Path $defaultPath) {
        $apk = Get-Item $defaultPath
        Write-Log "✓ Found APK: $defaultPath ($(Format-FileSize $apk.Length))" "SUCCESS"
        
        # Check if file is recent (within 24 hours)
        $age = (Get-Date) - $apk.LastWriteTime
        if ($age.TotalHours -gt 24) {
            Write-Log "WARNING: APK is $([math]::Round($age.TotalHours, 1)) hours old" "WARNING"
        }
        
        return $defaultPath
    }
    else {
        Write-Log "ERROR: APK not found at default location: $defaultPath" "ERROR"
        Write-Log "Build APK first: flutter build apk --release" "ERROR"
        Write-Log "Or specify custom path: -ApkPath [path]" "ERROR"
        exit 3
    }
}

function Get-FirebaseAppId {
    param([string]$CustomAppId)
    
    Write-Log "Resolving Firebase app ID..."
    
    # Use custom app ID if provided
    if ($CustomAppId) {
        if ($CustomAppId -match '^\d+:\d+:android:[a-f0-9]+$') {
            Write-Log "✓ Using custom app ID: $CustomAppId" "SUCCESS"
            return $CustomAppId
        }
        else {
            Write-Log "ERROR: Invalid app ID format: $CustomAppId" "ERROR"
            Write-Log "Expected format: 1:123456789:android:abc123def456" "ERROR"
            exit 4
        }
    }
    
    # Extract from firebase.json
    $firebaseJson = "firebase.json"
    if (-not (Test-Path $firebaseJson)) {
        Write-Log "ERROR: firebase.json not found in current directory" "ERROR"
        Write-Log "Ensure you're running from repository root" "ERROR"
        exit 4
    }
    
    try {
        $config = Get-Content $firebaseJson | ConvertFrom-Json
        $appId = $config.flutter.dart.'lib/firebase_options.dart'.configurations.android
        
        if (-not $appId) {
            throw "App ID not found in firebase.json"
        }
        
        Write-Log "✓ Extracted app ID from firebase.json: $appId" "SUCCESS"
        return $appId
    }
    catch {
        Write-Log "ERROR: Failed to extract app ID from firebase.json" "ERROR"
        Write-Log "Error: $_" "ERROR"
        Write-Log "Provide app ID explicitly: -AppId [id]" "ERROR"
        exit 4
    }
}

function Format-FileSize {
    param([long]$Bytes)
    
    if ($Bytes -ge 1GB) {
        return "{0:N2} GB" -f ($Bytes / 1GB)
    }
    elseif ($Bytes -ge 1MB) {
        return "{0:N2} MB" -f ($Bytes / 1MB)
    }
    elseif ($Bytes -ge 1KB) {
        return "{0:N2} KB" -f ($Bytes / 1KB)
    }
    else {
        return "$Bytes bytes"
    }
}

function Invoke-WithRetry {
    param(
        [scriptblock]$Command,
        [int]$MaxRetries = 3,
        [int]$InitialDelaySeconds = 5
    )
    
    $attempt = 1
    $delay = $InitialDelaySeconds
    
    while ($attempt -le $MaxRetries) {
        try {
            if ($attempt -gt 1) {
                Write-Log "Retry attempt $attempt/$MaxRetries..." "WARNING"
            }
            
            & $Command
            
            if ($LASTEXITCODE -eq 0) {
                return $true
            }
            else {
                throw "Command exited with code $LASTEXITCODE"
            }
        }
        catch {
            $errorMsg = $_.Exception.Message
            
            # Check if error is retriable (network-related)
            $isRetriable = $errorMsg -match 'network|timeout|connection|rate limit|timed out|ECONNRESET|ETIMEDOUT'
            
            if ($isRetriable -and $attempt -lt $MaxRetries) {
                Write-Log "Retriable error detected: $errorMsg" "WARNING"
                Write-Log "Waiting $delay seconds before retry..." "WARNING"
                Start-Sleep -Seconds $delay
                $delay *= 2  # Exponential backoff
                $attempt++
            }
            else {
                if ($attempt -ge $MaxRetries) {
                    Write-Log "ERROR: Max retries ($MaxRetries) reached" "ERROR"
                    Write-Log "Last error: $errorMsg" "ERROR"
                    exit 5
                }
                else {
                    # Non-retriable error
                    Write-Log "ERROR: $errorMsg" "ERROR"
                    
                    # Provide specific guidance based on error type
                    if ($errorMsg -match 'permission|forbidden|401|403') {
                        Write-Log "Permission denied - contact Firebase project admin" "ERROR"
                        exit 6
                    }
                    elseif ($errorMsg -match 'not found|404') {
                        Write-Log "Resource not found - check app ID and tester groups" "ERROR"
                        exit 7
                    }
                    else {
                        exit 99
                    }
                }
            }
        }
    }
}

#endregion

#region Main Script

Write-Host "`n========================================" -ForegroundColor Cyan
Write-Host "  Firebase APK Distribution" -ForegroundColor Cyan
Write-Host "========================================`n" -ForegroundColor Cyan

# Step 1: Validate prerequisites
Write-Step 1 5 "Validating prerequisites"

if (-not (Test-FirebaseCli)) { exit 1 }
if (-not (Test-FirebaseAuth)) { exit 2 }

if (-not (Test-Path "firebase.json")) {
    Write-Log "WARNING: firebase.json not found in current directory" "WARNING"
}

# Step 2: Resolve APK path
Write-Step 2 5 "Resolving APK path"
$resolvedApkPath = Get-ApkPath -CustomPath $ApkPath

# Validate APK file
$apkFile = Get-Item $resolvedApkPath
if ($apkFile.Length -eq 0) {
    Write-Log "ERROR: APK file is empty - 0 bytes" "ERROR"
    exit 3
}
if ($apkFile.Length -gt 1GB) {
    Write-Log "WARNING: APK size exceeds 1GB - may hit Firebase limits" "WARNING"
}

# Step 3: Extract Firebase app ID
Write-Step 3 5 "Extracting Firebase app ID"
$resolvedAppId = Get-FirebaseAppId -CustomAppId $AppId

# Step 4: Build Firebase command
Write-Step 4 5 "Preparing distribution command"

$firebaseCmd = "firebase appdistribution:distribute `"$resolvedApkPath`""
$firebaseCmd += " --app `"$resolvedAppId`""
$firebaseCmd += " --groups `"$Groups`""

if ($ReleaseNotes) {
    if ($ReleaseNotes.StartsWith("@")) {
        $notesFile = $ReleaseNotes.Substring(1)
        if (Test-Path $notesFile) {
            $firebaseCmd += " --release-notes-file `"$notesFile`""
            Write-Log "✓ Release notes from file: $notesFile" "SUCCESS"
        }
        else {
            Write-Log "WARNING: Release notes file not found: $notesFile" "WARNING"
            $firebaseCmd += " --release-notes `"Release notes file not found`""
        }
    }
    else {
        $firebaseCmd += " --release-notes `"$ReleaseNotes`""
        Write-Log "✓ Release notes: $ReleaseNotes"
    }
}

if ($env:FIREBASE_TOKEN) {
    $firebaseCmd += " --token `"$env:FIREBASE_TOKEN`""
    Write-Log "✓ Using CI token for authentication"
}

if ($Debug) {
    $firebaseCmd += " --debug"
    Write-Log "✓ Debug mode enabled"
}

Write-Log "Target groups: $Groups"

if ($DryRun) {
    Write-Host "`n========================================" -ForegroundColor Yellow
    Write-Host "  DRY RUN MODE - Preview Only" -ForegroundColor Yellow
    Write-Host "========================================`n" -ForegroundColor Yellow
    
    Write-Host "Would execute command:" -ForegroundColor Yellow
    Write-Host $firebaseCmd -ForegroundColor Gray
    
    Write-Host "`nDistribution details:" -ForegroundColor Yellow
    Write-Host "  APK: $resolvedApkPath" -ForegroundColor Gray
    Write-Host "  Size: $(Format-FileSize $apkFile.Length)" -ForegroundColor Gray
    Write-Host "  App ID: $resolvedAppId" -ForegroundColor Gray
    Write-Host "  Groups: $Groups" -ForegroundColor Gray
    if ($ReleaseNotes) {
        Write-Host "  Notes: $ReleaseNotes" -ForegroundColor Gray
    }
    
    Write-Host "`nNo upload performed (dry run mode)`n" -ForegroundColor Yellow
    exit 0
}

# Step 5: Execute upload with retry
Write-Step 5 5 "Uploading to Firebase App Distribution"

Write-Log "Starting upload... (this may take a few minutes)"
Write-Host ""

Invoke-WithRetry -Command {
    Invoke-Expression $firebaseCmd
}

# Calculate duration
$duration = (Get-Date) - $script:StartTime
$durationStr = "{0:N0}" -f $duration.TotalSeconds

# Success!
Write-Host "`n========================================" -ForegroundColor Green
Write-Host "  ✓ Distribution Successful!" -ForegroundColor Green
Write-Host "========================================`n" -ForegroundColor Green

Write-Host "Distribution complete:" -ForegroundColor Green
Write-Host "  APK: $resolvedApkPath" -ForegroundColor Gray
Write-Host "  Size: $(Format-FileSize $apkFile.Length)" -ForegroundColor Gray
Write-Host "  Tester Groups: $Groups" -ForegroundColor Gray
Write-Host "  Duration: $durationStr seconds" -ForegroundColor Gray

Write-Host "`nTesters will receive notification shortly.`n" -ForegroundColor Green

exit 0

#endregion
