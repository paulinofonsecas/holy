{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "VerseNotificationPayload",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "const": "verse_of_the_day"
        },
        "versionId": {
            "type": "string"
        },
        "bookId": {
            "type": "string"
        },
        "chapter": {
            "type": "integer"
        },
        "verse": {
            "type": "integer"
        }
    },
    "required": [
        "type",
        "versionId",
        "bookId",
        "chapter",
        "verse"
    ]
}